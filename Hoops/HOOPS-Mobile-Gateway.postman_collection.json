{
  "info": {
    "name": "HOOPS Mobile Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "7d8e5d4f-3b6e-4f6d-9f20-9a2df9c8b001"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/mobile/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": "1"
    },
    {
      "key": "court_id",
      "value": "1"
    },
    {
      "key": "notification_id",
      "value": "1"
    },
    {
      "key": "device_token",
      "value": "demo-device-token"
    }
  ],
  "item": [
    {
      "name": "Meta",
      "item": [
        {
          "name": "User Service Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/user-service/health"
          }
        },
        {
          "name": "Notification Service Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/notification-service/health"
          }
        },
        {
          "name": "Court Service Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/court-service/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mobile_user_1\",\n  \"email\": \"mobile_user_1@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mobile_user_1\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": "{{base_url}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "if (data.access_token) {",
                  "  pm.collectionVariables.set('token', data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users"
          }
        },
        {
          "name": "Leaderboard",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/leaderboard?limit=50&offset=0"
          }
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}"
          }
        },
        {
          "name": "Get User Internal",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}/internal"
          }
        },
        {
          "name": "Get User Rank Position",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}/rank-position"
          }
        }
      ]
    },
    {
      "name": "Ranking",
      "item": [
        {
          "name": "Ranking Leaderboard",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/ranking/leaderboard?limit=50&offset=0"
          }
        },
        {
          "name": "Process Game",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"session-1\",\n  \"winner_ids\": [1],\n  \"loser_ids\": [2]\n}"
            },
            "url": "{{base_url}}/ranking/process-game"
          }
        }
      ]
    },
    {
      "name": "Courts",
      "item": [
        {
          "name": "List Courts",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courts?city=Maribor&active_only=false"
          }
        },
        {
          "name": "Create Court",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Tabor Court\",\n  \"city\": \"Maribor\",\n  \"address\": \"Tabor 1\",\n  \"latitude\": 46.5547,\n  \"longitude\": 15.6459,\n  \"hoop_count\": 2,\n  \"court_type\": 0\n}"
            },
            "url": "{{base_url}}/courts"
          }
        },
        {
          "name": "Get Court by ID",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/courts/{{court_id}}"
          }
        },
        {
          "name": "Update Court Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": 1\n}"
            },
            "url": "{{base_url}}/courts/{{court_id}}/status"
          }
        },
        {
          "name": "Delete Court",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/courts/{{court_id}}"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/notifications?limit=50&offset=0&unread_only=false"
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/notifications/{{notification_id}}/read"
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Devices",
      "item": [
        {
          "name": "Register Device Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{device_token}}\",\n  \"platform\": \"android\",\n  \"deviceName\": \"Pixel 8\"\n}"
            },
            "url": "{{base_url}}/devices"
          }
        },
        {
          "name": "Delete Device Token",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/devices/{{device_token}}"
          }
        }
      ]
    },
    {
      "name": "Preferences",
      "item": [
        {
          "name": "Get Preferences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{base_url}}/preferences"
          }
        },
        {
          "name": "Update Preferences",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"gameStart\": true,\n  \"gameEnd\": true,\n  \"leaderboardUpdate\": true,\n  \"pushEnabled\": true,\n  \"emailEnabled\": false,\n  \"quietHoursStart\": null,\n  \"quietHoursEnd\": null\n}"
            },
            "url": "{{base_url}}/preferences"
          }
        }
      ]
    },
    {
      "name": "Notification Test Routes",
      "item": [
        {
          "name": "Generate Test JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 1\n}"
            },
            "url": "{{base_url}}/test/generate-token"
          }
        },
        {
          "name": "Create Test Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"type\": \"system\",\n  \"title\": \"Test Notification\",\n  \"body\": \"This is a test\"\n}"
            },
            "url": "{{base_url}}/test/create-notification"
          }
        }
      ]
    }
  ]
}
